.env
.env.local
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
**/.venv/
.venv-quality/
# Throwaway venv holding the vendor client SDKs for paper/conformance/sdk_conformance.py.
# They are test-time clients of the gateway, not dependencies of it, so they stay out of
# the service locks and out of the repository.
.venv-sdk-conformance/
.tools/
dist/
build/
.coverage
coverage.xml
htmlcov/
.tmp-*
*.tmp
.out/
results/**/*.json
results/**/*.md
results/**/*.html
results/**/*.sarif
results/**/*.txt
results/**/*.log
# Run logs sitting directly in any results/ directory (paper/conformance/results/*.log).
# The patterns above are anchored to the repo root and need an intermediate directory, so
# they never matched a log written straight into a nested results/.
**/results/*.log
!results/**/sample-*

# Generated paper figures
/paper/figures/

# mkdocs docs site build
/site/
/docs/runbooks/
/.venv-docs/
.DS_Store

# Vendored Helm subchart dependencies (umbrella chart, built at package time)
/deploy/charts/*/charts/
/deploy/charts/*/Chart.lock
!/deploy/charts/platform/Chart.lock
